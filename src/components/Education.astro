---
import Section from './Section.astro';
import { education } from '../data/education';

const tones = ['tone-green', 'tone-pink'];
---

<Section id="education" eyebrow="Education" title="Where I studied">
  <div class="edu-grid">
    {
      education.map((item, index) => (
        <article class:list={['tile', 'edu', tones[index % tones.length]]} data-reveal data-tilt>
          <p class="label">{item.dates}</p>
          <h3>{item.degree}</h3>
          <p class="school">
            {item.school} <span>· {item.location}</span>
          </p>
          <ul class="chip-list">
            <li class="chip chip-fill">GPA {item.gpa}</li>
            {item.note && <li class="chip">{item.note}</li>}
          </ul>
          <p class="label coursework-label">Coursework</p>
          <ul class="coursework">
            {item.coursework.map((course) => (
              <li>{course}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--gap);
  }

  .edu {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h3 {
    font-size: 1.35rem;
    margin-top: 4px;
  }

  .school {
    font-weight: 500;
  }

  .school span {
    color: var(--text-muted);
    font-weight: 400;
  }

  .chip-list {
    margin-top: 6px;
  }

  .coursework-label {
    margin-top: 14px;
  }

  .coursework {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
