---
import Section from './Section.astro';
import { skills } from '../data/skills';
---

<Section id="skills" eyebrow="Skills" title="What I work with">
  <div class="skill-grid">
    {
      skills.map((group) => (
        <div class:list={['tile', 'group', `tone-${group.tone}`]} data-reveal data-tilt>
          <h3>
            <span class="swatch" aria-hidden="true" />
            {group.name}
          </h3>
          <ul class="chip-list">
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--gap);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--tone);
    border: 1px solid var(--border);
  }
</style>
