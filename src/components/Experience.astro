---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { experience } from '../data/experience';
import { emphasize } from '../lib/format';

const tones = ['tone-orange', 'tone-green', 'tone-pink'];
---

<Section id="experience" eyebrow="Experience" title="Where I've worked">
  <ol class="jobs">
    {
      experience.map((job, index) => (
        <li class:list={['tile', 'job', tones[index % tones.length]]} data-reveal>
          <div class="meta">
            <div class="logo">
              {job.logo ? (
                <img src={job.logo} alt={`${job.company} logo`} width="52" height="52" loading="lazy" />
              ) : (
                <span aria-hidden="true">{job.company.charAt(0)}</span>
              )}
            </div>
            <p class="company">
              {job.companyUrl ? (
                <a href={job.companyUrl} target="_blank" rel="noopener">
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </p>
            <p class="label">{job.dates}</p>
            <p class="location">{job.location}</p>
          </div>
          <div class="body">
            <h3>{job.role}</h3>
            <ul class="bullets">
              {job.bullets.map((bullet) => (
                <li set:html={emphasize(bullet)} />
              ))}
            </ul>
            <ul class="chip-list" aria-label="Tech stack">
              {job.stack.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="more" data-reveal>
    <button class="btn btn-ghost" type="button" data-journey-open>
      See the whole journey, 2020 to today <Icon name="arrow-right" size={16} />
    </button>
  </p>
</Section>

<style>
  .jobs {
    list-style: none;
    display: grid;
    gap: var(--gap);
  }

  .job {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(20px, 3vw, 40px);
  }

  .more {
    margin-top: var(--gap);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .logo {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-2);
    display: grid;
    place-items: center;
    font-weight: 700;
    margin-bottom: 8px;
    box-shadow: 0 0 0 4px var(--tone);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .company {
    font-weight: 700;
  }

  .location {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h3 {
    font-size: 1.3rem;
  }

  @media (max-width: 760px) {
    .job {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .meta {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      row-gap: 2px;
      align-items: center;
    }

    .logo {
      grid-row: span 3;
      margin-bottom: 0;
    }
  }
</style>
