---
// "My journey" timeline in a pop-up. Any element with [data-journey-open] opens it.
import Icon from './Icon.astro';
import { journey } from '../data/journey';
---

<dialog class="journey" data-journey aria-labelledby="journey-title">
  <div class="bar">
    <div>
      <p class="label">2020 – today</p>
      <h2 id="journey-title">My journey</h2>
    </div>
    <form method="dialog">
      <button class="icon-btn" aria-label="Close timeline"><Icon name="close" /></button>
    </form>
  </div>

  <div class="scroll" data-journey-scroll>
    <div class="track">
    <span class="line" aria-hidden="true" data-journey-line></span>
    <ol class="timeline">
      {
        journey.map((step) => (
          <li class:list={['step', `tone-${step.tone}`]} data-journey-step>
            <span class="dot" aria-hidden="true" />
            <p class="label">
              <time>{step.date}</time> · {step.kind}
            </p>
            <h3>{step.title}</h3>
            <p class="detail">{step.detail}</p>
          </li>
        ))
      }
      <li class="step next tone-orange" data-journey-step>
        <span class="dot" aria-hidden="true" />
        <p class="label">Next</p>
        <h3>Your team?</h3>
        <a class="btn btn-primary" href="#contact" data-journey-contact>
          Get in touch <Icon name="arrow-right" size={16} />
        </a>
      </li>
    </ol>
    </div>
  </div>
</dialog>

<script>
  import { gsap } from 'gsap';

  const dialog = document.querySelector<HTMLDialogElement>('[data-journey]');

  const animateIn = () => {
    if (!dialog || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const phone = window.matchMedia('(max-width: 768px)').matches;
    gsap
      .timeline({ defaults: { ease: 'power2.out' } })
      .fromTo(dialog, { y: phone ? 16 : 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.35 })
      .fromTo(
        '[data-journey-line]',
        { scaleY: 0 },
        { scaleY: 1, duration: phone ? 0.6 : 1, ease: 'power1.inOut' },
        0.15,
      )
      .fromTo(
        '[data-journey-step]',
        { x: phone ? 0 : -12, y: phone ? 8 : 0, autoAlpha: 0 },
        { x: 0, y: 0, autoAlpha: 1, duration: 0.4, stagger: phone ? 0.05 : 0.08 },
        0.2,
      );
  };

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest('[data-journey-open]');
    if (!trigger || !dialog) return;
    event.preventDefault();
    dialog.querySelector<HTMLElement>('[data-journey-scroll]')?.scrollTo(0, 0);
    dialog.showModal();
    animateIn();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // Close first, then follow the link to the contact section.
  dialog?.querySelector('[data-journey-contact]')?.addEventListener('click', () => dialog.close());
</script>

<style>
  .journey {
    width: min(720px, calc(100vw - 24px));
    max-height: min(860px, calc(100dvh - 24px));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .journey[open] {
    display: flex;
    flex-direction: column;
  }

  .journey::backdrop {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(4px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 18px 14px clamp(20px, 4vw, 32px);
    border-bottom: 1px solid var(--border);
  }

  h2 {
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  .scroll {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(20px, 4vw, 32px);
  }

  .track {
    position: relative;
  }

  .timeline {
    list-style: none;
    display: grid;
    gap: 26px;
    padding-left: 34px;
  }

  .line {
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
    transform-origin: top;
  }

  .step {
    position: relative;
    display: grid;
    gap: 4px;
  }

  .dot {
    position: absolute;
    left: -34px;
    top: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--tone);
    border: 3px solid var(--surface);
    /* Pink and neutral are too pale to see on their own, so every dot gets a visible ring. */
    box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--text) 45%, transparent);
  }

  h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .detail {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .next h3 {
    font-size: 1.35rem;
  }

  .next .btn {
    justify-self: start;
    margin-top: 8px;
  }
</style>
