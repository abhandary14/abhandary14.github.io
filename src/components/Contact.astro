---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { site, services } from '../data/site';
---

<Section id="contact" eyebrow="Contact" title="Let's talk" tinted>
  <div class="contact">
    <div class="intro" data-reveal>
      <p>
        I'm available immediately and open to full-time software engineering roles. Send me a message and I'll get
        back to you soon.
      </p>
      <p class="direct">
        Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <form class="card form" data-contact-form data-access-key={services.web3formsAccessKey} data-reveal novalidate>
      <div class="row">
        <label>
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required maxlength="200" />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input name="subject" type="text" required maxlength="200" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="6" required maxlength="5000"></textarea>
      </label>

      <!-- Spam trap: real visitors never see or fill this. -->
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="submit-row">
        <button class="btn btn-primary" type="submit" data-submit>
          <Icon name="send" /> Send message
        </button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

  const setStatus = (message: string, tone: 'ok' | 'error' | '' = '') => {
    if (!status) return;
    status.textContent = message;
    status.dataset.tone = tone;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const accessKey = form.dataset.accessKey;

    // Without a Web3Forms key, fall back to opening the visitor's email app.
    if (!accessKey) {
      const body = `${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`;
      const email = document.querySelector<HTMLAnchorElement>('.direct a')?.href ?? '';
      window.location.href = `${email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(body)}`;
      return;
    }

    data.append('access_key', accessKey);
    data.append('from_name', 'Portfolio contact form');
    if (submit) submit.disabled = true;
    setStatus('Sending…');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message);
      form.reset();
      setStatus("Thanks! Your message is on its way. I'll reply soon.", 'ok');
    } catch {
      setStatus('Something went wrong. Please try again, or email me directly.', 'error');
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }

  .intro {
    display: grid;
    gap: 16px;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .direct a {
    font-weight: 600;
    word-break: break-word;
  }

  .form {
    display: grid;
    gap: 16px;
    padding: clamp(20px, 3vw, 28px);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    font-size: 0.93rem;
    color: var(--text-muted);
  }

  .status[data-tone='ok'] {
    color: var(--mint-ink);
  }

  .status[data-tone='error'] {
    color: var(--pink-ink);
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
