---
// Shared wrapper that gives every section the same heading style and spacing.
// The heading sits on a solid patch so the dot grid never runs behind text.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="label">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(36px, 5vw, 64px);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .section-head > * {
    background: var(--bg);
    box-shadow: 0 0 0 8px var(--bg);
  }

  h2 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
  }
</style>
