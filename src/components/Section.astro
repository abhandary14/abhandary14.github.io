---
// Shared wrapper that gives every section the same heading style and spacing.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  tinted?: boolean;
}

const { id, eyebrow, title, tinted = false } = Astro.props;
---

<section id={id} class:list={['section', { tinted }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(64px, 10vw, 112px);
  }

  .section.tinted {
    background: var(--bg-tint);
  }

  .section-head {
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.01em;
  }
</style>
