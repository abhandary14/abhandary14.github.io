---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  showBlog?: boolean;
}

const { showBlog = false } = Astro.props;

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#education', label: 'Education' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#publications', label: 'Publications' },
  { href: '/#skills', label: 'Skills' },
  ...(showBlog ? [{ href: '/#blog', label: 'Blog' }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header" data-header>
  <nav class="nav" aria-label="Main">
    <a class="brand" href="/" aria-label={`${site.shortName}, home`}>
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>{site.shortName}</span>
    </a>

    <ul class="nav-links" id="nav-links" data-nav-links>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <a
        class="btn btn-primary resume-btn"
        href={site.resume}
        target="_blank"
        rel="noopener"
        data-resume-open
        data-goatcounter-click="resume-view"
        data-goatcounter-title="Resume viewed (nav)">Resume</a
      >
      <ThemeToggle />
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-controls="nav-links"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-btn
      >
        <span class="icon-open"><Icon name="menu" /></span>
        <span class="icon-close"><Icon name="close" /></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-nav-links]');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  button?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding-inline: var(--gutter);
    margin-top: 12px;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: var(--max);
    margin-inline: auto;
    padding: 8px 8px 8px 16px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }

  .brand img {
    border-radius: 8px;
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-links a {
    display: block;
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .resume-btn {
    min-height: 40px;
    padding: 6px 18px;
  }

  .nav-actions :global(.icon-btn) {
    width: 40px;
    height: 40px;
  }

  .menu-btn,
  .icon-close {
    display: none;
  }

  .menu-open .icon-open {
    display: none;
  }

  .menu-open .icon-close {
    display: inline-flex;
  }

  @media (max-width: 1080px) {
    .menu-btn {
      display: inline-flex;
    }

    .nav-links {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      padding: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      display: none;
    }

    .menu-open .nav-links {
      display: flex;
    }

    .nav-links a {
      padding: 12px 14px;
      font-size: 1rem;
      border-radius: var(--radius-sm);
    }
  }

  @media (max-width: 420px) {
    .brand span {
      display: none;
    }
  }
</style>
