---
// One card in the Featured Projects grid. Used for GitHub projects (data/projects.ts)
// and academic write-ups (content/projects/*.md).
import Icon from './Icon.astro';
import type { ProjectImage, ProjectLink } from '../data/projects';

interface Props {
  title: string;
  kind: string;
  summary: string;
  tags: string[];
  tone: string;
  screenshots?: ProjectImage[];
  repo?: string;
  writeup?: string; // link to the project's own page
  links?: ProjectLink[];
}

const { title, kind, summary, tags, tone, screenshots = [], repo, writeup, links = [] } = Astro.props;
const [cover, ...rest] = screenshots;
const gallery = screenshots.slice(0, 3);
const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');
---

<article class:list={['tile', 'project', tone]} data-reveal data-tilt>
  <div class="media">
    {
      cover ? (
        <button class="cover" type="button" data-lightbox-src={cover.src} data-lightbox-alt={cover.alt} aria-label={`View screenshot: ${cover.alt}`}>
          <img src={cover.src} alt={cover.alt} loading="lazy" />
        </button>
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span class="mono">{initials}</span>
        </div>
      )
    }
  </div>

  {
    rest.length > 0 && (
      <ul class="thumbs" aria-label="More screenshots">
        {gallery.slice(1).map((shot) => (
          <li>
            <button type="button" data-lightbox-src={shot.src} data-lightbox-alt={shot.alt} aria-label={`View screenshot: ${shot.alt}`}>
              <img src={shot.src} alt="" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <div class="body">
    <p class="label">{kind}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="chip-list" aria-label="Tech stack">
          {tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="actions">
      {
        repo && (
          <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">
            <Icon name="github" size={16} /> Read more on GitHub
          </a>
        )
      }
      {
        writeup && (
          <a class="btn btn-ghost" href={writeup}>
            Read the write-up <Icon name="arrow-right" size={16} />
          </a>
        )
      }
      {
        links.length > 0 && (
          <div class="links">
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .project:hover {
    box-shadow: var(--shadow-hover);
  }

  .media {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .cover {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    background: none;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Until screenshots exist: a tinted dot pattern with the project's initials. */
  .placeholder {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle, rgb(0 0 0 / 0.16) 1.2px, transparent 1.8px) 0 0 / 16px 16px,
      var(--tone);
  }

  .placeholder span {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 500;
    color: var(--on-accent);
    background: var(--tone);
    padding: 0 12px;
  }

  .thumbs {
    list-style: none;
    display: flex;
    gap: 8px;
    padding: 12px 20px 0;
  }

  .thumbs button {
    display: block;
    width: 72px;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    cursor: zoom-in;
    background: none;
  }

  .thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: clamp(20px, 2.4vw, 24px);
  }

  h3 {
    font-size: 1.2rem;
  }

  .summary {
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: auto;
    padding-top: 8px;
  }

  .actions .btn {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-weight: 500;
    font-size: 0.93rem;
  }
</style>
