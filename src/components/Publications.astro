---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { publications } from '../data/publications';
---

<Section id="publications" eyebrow="Research" title="Publications">
  <ol class="pubs">
    {
      publications.map((pub) => (
        <li class:list={['tile', 'pub', { awarded: pub.award }]} data-reveal>
          <div class="pub-text">
            {pub.award && (
              <p class="award chip chip-fill tone-green">
                <Icon name="award" size={14} /> {pub.award.title} · {pub.award.detail}
              </p>
            )}
            <h3>
              <a href={pub.href} target="_blank" rel="noopener">
                {pub.title}
              </a>
            </h3>
            <p class="authors">{pub.authors}</p>
            <p class="label">
              {pub.venue} · {pub.year}
            </p>
            <a class="btn btn-ghost read" href={pub.href} target="_blank" rel="noopener">
              Read on IEEE Xplore <Icon name="external" size={15} />
            </a>
          </div>

          {pub.award && (
            <button
              class="thumb"
              type="button"
              data-lightbox-src={pub.award.image}
              data-lightbox-alt={pub.award.imageAlt}
              aria-label={`View ${pub.award.title} certificate full size`}
            >
              <img src={pub.award.image} alt={pub.award.imageAlt} loading="lazy" />
              <span class="thumb-hint mono">View certificate</span>
            </button>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .pubs {
    list-style: none;
    display: grid;
    gap: var(--gap);
  }

  .pub {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }

  .pub.awarded {
    grid-template-columns: 1fr minmax(200px, 300px);
  }

  .pub-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .award {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  h3 {
    font-size: 1.2rem;
    line-height: 1.35;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }

  .authors {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .label {
    text-transform: none;
  }

  .read {
    margin-top: 8px;
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.9rem;
  }

  .thumb {
    position: relative;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    corner-shape: squircle;
    overflow: hidden;
    background: #fff;
    cursor: zoom-in;
    transition: transform 0.25s ease;
  }

  .thumb:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .thumb-hint {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    background: rgb(0 0 0 / 0.78);
    color: #fff;
  }

  @media (max-width: 720px) {
    .pub.awarded {
      grid-template-columns: 1fr;
    }
  }
</style>
