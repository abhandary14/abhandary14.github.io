---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';
import { experience } from '../data/experience';
import { education } from '../data/education';

const current = experience[0];
const degree = education[0];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="bento">
    <!-- Intro -->
    <div class="tile t-intro" data-hero-tile data-tilt>
      <p class="label">Software engineer</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="tagline">{site.tagline}.</p>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={site.resume}
          target="_blank"
          rel="noopener"
          data-resume-open
          data-goatcounter-click="resume-view"
          data-goatcounter-title="Resume viewed (hero)"
        >
          View resume
        </a>
        <a
          class="btn btn-ghost"
          href={site.resume}
          download="Aakash_Bhandary_Resume.pdf"
          data-goatcounter-click="resume-download"
          data-goatcounter-title="Resume downloaded (hero)"
        >
          <Icon name="download" /> Download
        </a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>

    <!-- Photo -->
    <div class="tile t-photo" data-hero-tile>
      <img src={site.profilePhoto} alt={`Portrait of ${site.shortName}`} width="600" height="600" />
    </div>

    <!-- Availability -->
    <div class="tile t-small" data-hero-tile data-tilt>
      <p class="status"><span class="pulse" aria-hidden="true"></span>{site.availability}</p>
      <p class="muted">{site.openTo}.</p>
    </div>

    <!-- Location + local time -->
    <div class="tile t-small" data-hero-tile data-tilt>
      <p class="label"><Icon name="map-pin" size={14} /> Current location</p>
      <p class="big">{site.location}</p>
      <p class="muted mono" data-clock data-tz={site.timeZone}>Eastern Time</p>
    </div>

    <!-- Education -->
    <a class="tile t-small t-edu fill-pink" href="#education" data-hero-tile data-tilt>
      <p class="label"><Icon name="graduation" size={14} /> Education</p>
      <p class="big">M.S. Computer Science</p>
      <p class="small">NC State · {degree.gpa.replace(' / ', '/')} GPA</p>
    </a>

    <!-- Currently -->
    <a class="tile t-now" href="#experience" data-hero-tile data-tilt>
      <p class="label">Currently</p>
      <p class="big">
        {current.role.replace(' (Volunteer)', '')} at {current.company}
      </p>
      <ul class="chip-list" aria-label="Tech stack">
        {current.stack.map((item) => <li class="chip">{item}</li>)}
      </ul>
    </a>

    <!-- Links -->
    <div class="tile t-links" data-hero-tile data-tilt>
      <p class="label">Find me</p>
      <ul>
        {
          socials.map((social) => (
            <li>
              <a href={social.href} target={social.icon === 'mail' ? undefined : '_blank'} rel="noopener">
                <Icon name={social.icon} size={17} />
                <span>{social.label}</span>
                <Icon name={social.icon === 'mail' ? 'arrow-right' : 'external'} size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Off the clock -->
    <div class="tile t-tennis" data-hero-tile data-tilt>
      <span class="ball" aria-hidden="true"><Icon name="tennis" size={22} /></span>
      <div>
        <p class="label">Off the clock</p>
        <p>{site.offTheClock}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Live local time in the location tile.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: clock.dataset.tz,
      timeZoneName: 'short',
    });
    const tick = () => (clock.textContent = `${format.format(new Date())} local time`);
    tick();
    setInterval(tick, 15_000);
  }
</script>

<style>
  .hero {
    padding-top: clamp(24px, 4vw, 48px);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .t-intro {
    grid-column: span 7;
    grid-row: span 2;
    justify-content: flex-end;
    gap: 14px;
    padding: clamp(24px, 3.6vw, 44px);
  }

  .t-photo {
    grid-column: span 5;
    grid-row: span 2;
    padding: 0;
    overflow: hidden;
    min-height: 380px;
  }

  .t-small {
    grid-column: span 4;
  }

  .t-now {
    grid-column: span 6;
  }

  .t-links,
  .t-tennis {
    grid-column: span 3;
  }

  h1 {
    font-size: clamp(2.5rem, 6.4vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--text-muted);
    max-width: 30ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .t-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .big {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .muted {
    color: var(--text-muted);
    font-size: 0.93rem;
  }

  .small {
    font-size: 0.9rem;
  }

  .mono.muted {
    font-size: 0.82rem;
  }

  a.tile {
    text-decoration: none;
  }

  a.tile:hover {
    box-shadow: var(--shadow-hover);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: auto;
  }

  .pulse {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--orange);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--orange);
    animation: ping 1.8s ease-out infinite;
  }

  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse::after {
      animation: none;
    }
  }

  .t-now .chip-list {
    margin-top: auto;
    padding-top: 10px;
  }

  .t-links ul {
    list-style: none;
    display: grid;
  }

  .t-links a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .t-links li:last-child a {
    border-bottom: 0;
  }

  .t-links a span {
    flex: 1;
  }

  .t-links a:hover span {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
  }

  .t-tennis {
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .ball {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green);
    color: var(--on-accent);
  }

  @media (max-width: 1024px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }

    .t-intro {
      grid-column: span 4;
    }

    .t-photo {
      grid-column: span 2;
      min-height: 320px;
    }

    .t-small {
      grid-column: span 2;
    }

    .t-links,
    .t-tennis {
      grid-column: span 3;
    }

    .t-now {
      grid-column: span 6;
    }
  }

  @media (max-width: 680px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .t-intro,
    .t-photo,
    .t-now {
      grid-column: span 2;
      grid-row: auto;
    }

    .t-photo {
      order: -1;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .t-small,
    .t-links,
    .t-tennis {
      grid-column: span 1;
    }

    .t-edu,
    .t-links,
    .t-tennis {
      grid-column: span 2;
    }

    .big {
      font-size: 1.02rem;
    }
  }
</style>
