---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | ${site.shortName}`} description={post.data.description} showBlog>
  <article class="container post">
    <a class="back" href="/#blog">← Back to all posts</a>
    <header>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 760px;
    padding-block: 48px 96px;
  }

  .back {
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
  }

  header {
    margin-block: 24px 36px;
  }

  time {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  h1 {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.01em;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .prose :global(:is(p, ul, ol, pre, blockquote)) {
    margin-block: 0 1.1em;
  }

  .prose :global(:is(h2, h3)) {
    margin-block: 1.6em 0.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(pre) {
    padding: 16px;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: 0.9rem;
  }

  .prose :global(:not(pre) > code) {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    font-size: 0.92em;
  }

  .prose :global(blockquote) {
    padding-left: 16px;
    border-left: 3px solid var(--lavender);
    color: var(--text-muted);
  }

  .prose :global(img) {
    border-radius: var(--radius-sm);
  }
</style>
